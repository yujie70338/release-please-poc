FROM node:26.8.1-alpine3.24

RUN apk add --no-cache git ca-certificates

WORKDIR /workspace

# Install Nx Release as a project-local dependency at
# /workspace/node_modules/.bin/nx, using this repository's lockfile.
COPY package.json package-lock.json ./
RUN npm ci --include=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force

# npm only adds node_modules/.bin to PATH when running an npm script. Docker
# ENTRYPOINT does not, so add the project-local Nx binary explicitly.
ENV PATH="/workspace/node_modules/.bin:${PATH}"

# Pass release behavior at runtime, for example --dry-run, --git-tag, or
# --git-commit --git-tag --git-push.
ENTRYPOINT ["nx", "release", "version"]
